{
  "compilerOptions": {
    "target": "ES2021",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": ".selftest-build"
  },
  "include": ["src/domain/**/*.ts", "src/config/**/*.ts", "scripts/**/*.ts"]
}
